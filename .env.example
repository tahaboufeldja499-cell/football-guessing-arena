# انسخ هذا الملف إلى .env.local وضع قيم مشروعك من Supabase
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح anon / publishable فقط (مفتاح عام بطبيعته). لا تضع هنا مفتاح service_role أبدًا.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# (اختياري) رابط موقعك المنشور، يُستعمل في «رابط الدعوة» داخل تطبيق أندرويد (لأن عنوان التطبيق الداخلي localhost)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
